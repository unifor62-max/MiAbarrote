# Public: demo enables the simulator; cloud requires the protected server API.
VITE_PAYMENT_MODE=demo

# Server only. Use distinct random keys of at least 32 characters.
PAYMENT_WEBHOOK_KEY=
# Optional legacy key; automatic prototype sessions do not require it.
PAYMENT_READER_KEY=
PAYMENT_SESSION_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Use a different namespace for production and each preview environment.
PAYMENT_NAMESPACE=miabarrote-demo
